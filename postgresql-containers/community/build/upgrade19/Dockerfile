# PostgreSQL 19 (BETA, tech preview) community upgrade image.
# Hand-maintained — NOT generated by sync.sh, for the same reason as
# build/postgres19/Dockerfile: ppg-19 packages do not exist, so there is no
# Percona source Dockerfile to derive this file from, and PostgreSQL 19 lives
# in the PGDG *testing* repository (the stable yum/19 repository returns 404).
#
# It carries the PostgreSQL 19 target binaries next to the 18 source ones, so
# pg_upgrade can move a cluster to 19. The job copies the old cluster's
# shared_preload_libraries into the new postgresql.conf before running
# pg_upgrade --check, which starts both servers — every preloaded library must
# therefore exist for BOTH versions in this image.
#
# For PostgreSQL 19 the testing repository ships the server packages only:
# no pgaudit_19, set_user_19, wal2json_19, pgvector_19, pg_repack_19 or
# pg_cron_19, and no timescaledb-2-postgresql-19. That is why the image is
# deliberately minimal — see the install step below.
#
# At GA: delete this file and build the upgrade image from the regular
# build/upgrade/Dockerfile with PG_MAJOR=19.

ARG BASE_IMAGE=redhat/ubi9-minimal

# Pin the prerelease, exactly as build/postgres19/Dockerfile does and for the
# same reason — keep the two files on the same beta, or pg_upgrade will move a
# cluster onto a PostgreSQL build the target image does not run.
ARG PG19_RELEASE=beta3
ARG PG19_RPM="19-${PG19_RELEASE}_1PGDG*"

# ── pgAudit builder ───────────────────────────────────────────────────────────
# Mirrors build/postgres19/Dockerfile: PGDG does not build the pgaudit_19 rpm
# for beta PG versions, but pgAudit upstream already supports PostgreSQL 19.
FROM ${BASE_IMAGE} AS pgaudit-builder
ARG PG19_RELEASE
ARG PG19_RPM

RUN set -ex; \
    ARCH=$(uname -m); \
    EL_VER=$(. /etc/os-release && echo "${VERSION_ID%%.*}"); \
    curl -Lf -o /tmp/pgdg-repo.rpm \
        "https://download.postgresql.org/pub/repos/yum/reporpms/EL-${EL_VER}-${ARCH}/pgdg-redhat-repo-latest.noarch.rpm"; \
    rpm -i /tmp/pgdg-repo.rpm; \
    rm /tmp/pgdg-repo.rpm; \
    printf "[pgdg19-testing]\nname=PGDG 19 testing\nbaseurl=https://download.postgresql.org/pub/repos/yum/testing/19/redhat/rhel-${EL_VER}-${ARCH}\nenabled=1\ngpgcheck=1\ngpgkey=https://download.postgresql.org/pub/repos/yum/keys/PGDG-RPM-GPG-KEY-RHEL https://download.postgresql.org/pub/repos/yum/keys/PGDG-RPM-GPG-KEY-AARCH64-RHEL\n" \
        > /etc/yum.repos.d/pgdg-19-testing.repo; \
    microdnf -y install gcc make git redhat-rpm-config krb5-devel openssl-devel dnf dnf-plugins-core \
        "postgresql19-${PG19_RPM}"; \
    microdnf clean all

# postgresql19-devel requires perl(IPC::Run), which lives in the RHEL CRB repo
# and is unavailable in UBI images. It is only used by the devel package's
# regression-test harness — PGXS extension builds do not need it — so install
# the devel rpm without dependency resolution.
RUN set -ex; \
    dnf -y download --downloaddir /tmp "postgresql19-devel-${PG19_RPM}"; \
    rpm -i --nodeps /tmp/postgresql19-devel-*.rpm; \
    rm /tmp/postgresql19-devel-*.rpm; \
    git clone --depth 1 --branch "19${PG19_RELEASE}" https://github.com/pgaudit/pgaudit.git /tmp/pgaudit; \
    make -C /tmp/pgaudit install USE_PGXS=1 PG_CONFIG=/usr/pgsql-19/bin/pg_config with_llvm=no


FROM ${BASE_IMAGE}
ARG PG19_RPM

LABEL name="Percona PostgreSQL Distribution upgrade" \
    vendor="community" \
    summary="Percona Distribution for PostgreSQL" \
    description="Percona Distribution for PostgreSQL is a collection of tools to assist you in managing your PostgreSQL database system" \
    maintainer="Percona Development <info@percona.com>"

RUN set -ex; \
    microdnf -y update; \
    microdnf -y install glibc-langpack-en platform-python tar; \
    microdnf clean all; \
    rm -rf /var/cache/dnf /var/cache/yum

ENV LC_ALL=en_US.utf-8
ENV LANG=en_US.utf-8

# Install PGDG, EPEL and the PGDG 19 testing repositories
RUN set -ex; \
    ARCH=$(uname -m); \
    EL_VER=$(. /etc/os-release && echo "${VERSION_ID%%.*}"); \
    curl -Lf -o /tmp/pgdg-repo.rpm \
        "https://download.postgresql.org/pub/repos/yum/reporpms/EL-${EL_VER}-${ARCH}/pgdg-redhat-repo-latest.noarch.rpm"; \
    curl -Lf -o /tmp/epel-release.rpm \
        "https://dl.fedoraproject.org/pub/epel/epel-release-latest-${EL_VER}.noarch.rpm"; \
    rpm -i /tmp/pgdg-repo.rpm /tmp/epel-release.rpm; \
    rm /tmp/pgdg-repo.rpm /tmp/epel-release.rpm; \
    printf "[pgdg19-testing]\nname=PGDG 19 testing\nbaseurl=https://download.postgresql.org/pub/repos/yum/testing/19/redhat/rhel-${EL_VER}-${ARCH}\nenabled=1\ngpgcheck=1\ngpgkey=https://download.postgresql.org/pub/repos/yum/keys/PGDG-RPM-GPG-KEY-RHEL https://download.postgresql.org/pub/repos/yum/keys/PGDG-RPM-GPG-KEY-AARCH64-RHEL\n" \
        > /etc/yum.repos.d/pgdg-19-testing.repo; \
    microdnf clean all

# Both sides of the upgrade: pg_upgrade ships with postgresql19-server and
# needs the PostgreSQL 18 binaries to start the old cluster (--old-bindir).
# Only 18 is installed as a source: it is the single upgrade path to 19 while
# PostgreSQL 19 is in beta. contrib carries pg_stat_statements, which the
# operator puts in shared_preload_libraries when PMM uses it as query source.
# The other versioned extensions are left out on purpose: none of them is
# built for 19, so a cluster using one cannot pass the pg_upgrade check for
# loadable libraries no matter what this image contains.
RUN set -ex; \
    microdnf -y install \
        "postgresql19-server-${PG19_RPM}" \
        "postgresql19-contrib-${PG19_RPM}" \
        "postgresql19-libs-${PG19_RPM}" \
        postgresql18-server \
        postgresql18-contrib \
        postgresql18-libs \
        pgaudit_18 \
        nss_wrapper \
        lz4; \
    microdnf -y reinstall tzdata; \
    microdnf clean all; \
    rm -rf /var/cache/dnf /var/cache/yum

# pgAudit is the one extension that must be here: the operator enables it by
# default, so it is always in shared_preload_libraries and the new cluster
# would refuse to start without it.
COPY --from=pgaudit-builder /usr/pgsql-19/lib/pgaudit.so /usr/pgsql-19/lib/
COPY --from=pgaudit-builder /usr/pgsql-19/share/extension/pgaudit* /usr/pgsql-19/share/extension/

RUN mkdir -p /opt/crunchy/bin /pgolddata /pgnewdata /opt/crunchy/conf
COPY bin/upgrade/ /opt/crunchy/bin
COPY bin/common /opt/crunchy/bin
COPY conf/upgrade/ /opt/crunchy/conf
COPY bin/relocate-extensions.sh /usr/local/bin/relocate-extensions.sh
COPY licenses/LICENSE.txt /licenses/LICENSE.Dockerfile

RUN chown -R postgres:postgres /opt/crunchy /pgolddata /pgnewdata && \
    chmod -R g=u /opt/crunchy /pgolddata /pgnewdata

VOLUME /pgolddata /pgnewdata

ENV NSS_WRAPPER_SUBDIR="upgrade"

ENTRYPOINT ["opt/crunchy/bin/uid_postgres.sh"]

USER 26

CMD ["/opt/crunchy/bin/start.sh"]
