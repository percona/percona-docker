# Hand-maintained beta overlay — NOT generated by sync.sh.
#
# pgBackRest repo-host image for PostgreSQL 19 (beta): the PGDG pgbackrest rpm
# (2.58) fails PG 19 with VersionNotSupportedError, and pgBackRest requires
# matching versions across repo-host and clients. Build pgBackRest 2.59.0
# (first release with PG 19 support) from the official dist tarball and layer
# the binary over the regular community pgbackrest image.
#
# Delete this image once PGDG publishes the pgbackrest >= 2.59.0 rpm and the
# community pgbackrest image is rebuilt (then main-pgbackrest19 becomes a plain
# retag of the community image, or a real ppg-19 build at GA).

ARG BASE_IMAGE=perconalab/percona-postgresql-operator:main-pgbackrest-community

FROM redhat/ubi9-minimal AS pgbackrest-builder

ARG PGBACKREST_VERSION=2.59.0

RUN set -ex; \
    EL_VER=$(. /etc/os-release && echo "${VERSION_ID%%.*}"); \
    curl -Lf -o /tmp/epel-release.rpm \
        "https://dl.fedoraproject.org/pub/epel/epel-release-latest-${EL_VER}.noarch.rpm"; \
    rpm -i /tmp/epel-release.rpm; \
    rm /tmp/epel-release.rpm; \
    microdnf install -y \
        gcc make meson ninja-build pkgconf-pkg-config python3 \
        openssl-devel libxml2-devel zlib-devel bzip2-devel \
        lz4-devel libzstd-devel libyaml-devel libpq-devel \
        tar gzip; \
    microdnf clean all

RUN set -ex; \
    curl -Lf -o /tmp/pgbackrest.tar.gz \
        "https://github.com/pgbackrest/pgbackrest/releases/download/release%2F${PGBACKREST_VERSION}/pgbackrest-${PGBACKREST_VERSION}.tar.gz"; \
    tar -xzf /tmp/pgbackrest.tar.gz -C /tmp; \
    meson setup /tmp/build "/tmp/pgbackrest-${PGBACKREST_VERSION}"; \
    ninja -C /tmp/build; \
    /tmp/build/src/pgbackrest version

FROM ${BASE_IMAGE}

COPY --from=pgbackrest-builder /tmp/build/src/pgbackrest /usr/bin/pgbackrest
